<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full h-screen text-white p-10">
        <h3 class="text-3xl mb-5">Upload File</h3>
        <form autocomplete="off " action="/upload" method="post" enctype="multipart/form-data">
            <input type="file" name="image">
            <input class="py-2 px-3 outline-none border-2 border-zinc-800 bg-purple-900 rounded-lg cursor-pointer" type="submit" value="Upload File">
            
        </form>

    </div>
</body>
</html>